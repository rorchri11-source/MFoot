<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Da Android 13 le notifiche si chiedono, non si danno per scontate.

      Senza questo permesso il sistema scarta ogni notifica **in silenzio**: nessun errore,
      nessun avviso, semplicemente non compare niente. E' il tipo di guasto che si scopre
      solo notando che non arriva mai niente — cioe' esattamente il problema da cui nasce
      tutto questo lavoro.

      Sui telefoni piu' vecchi il permesso non esiste e viene ignorato.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      L'icona va dichiarata, o Android ne mette una di sistema.

      Era proprio questo il motivo per cui l'app compariva senza icona: i file
      dell'icona adattiva c'erano da sempre, ma nessuno diceva al sistema di usarli. Un
      launcher che non trova `android:icon` non va a cercarsela.
    -->
    <application
        android:name=".MFootApplication"
        android:label="MFoot"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.MFoot">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MFoot">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Chi riceve i messaggi del server.

          `exported="false"`: lo chiama solo il servizio di Google installato sul telefono,
          non un'altra applicazione.
        -->
        <service
            android:name=".push.MFootMessaging"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>
