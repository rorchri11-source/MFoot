<?xml version="1.0" encoding="utf-8"?>
<!--
  Il segno di MFoot.

  Un'icona adattiva viene ritagliata dal launcher in forme diverse — cerchio, squircle,
  goccia — e il taglio puo' arrivare fino al 33% del bordo. Per questo il disegno vive
  tutto nel riquadro centrale sicuro: 72dp su 108dp. Un logo che tocca i bordi funziona
  su un telefono e viene decapitato su un altro.

  Il segno e' la porta vista di fronte, con la traversa e i pali: la cosa piu' semplice
  che dice "calcio" senza essere l'ennesimo pallone a esagoni, e leggibile anche a 48dp
  nella barra delle notifiche.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Traversa e pali. Spessi: a icona piccola le linee sottili spariscono. -->
    <path
        android:strokeColor="#2BE07E"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M28,44 L28,72 M80,44 L80,72 M28,44 L80,44" />

    <!-- La rete, appena accennata: due montanti interni e una traversa bassa. -->
    <path
        android:strokeColor="#2BE07E"
        android:strokeWidth="2.5"
        android:strokeAlpha="0.45"
        android:strokeLineCap="round"
        android:pathData="M45,44 L45,72 M63,44 L63,72 M28,58 L80,58" />

    <!-- Il pallone che entra: pieno, cosi' resta visibile anche in miniatura. -->
    <path
        android:fillColor="#2BE07E"
        android:pathData="M54,64 m-8,0 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0" />

    <!-- La linea di porta. -->
    <path
        android:strokeColor="#2BE07E"
        android:strokeWidth="4"
        android:strokeAlpha="0.8"
        android:strokeLineCap="round"
        android:pathData="M22,76 L86,76" />
</vector>
