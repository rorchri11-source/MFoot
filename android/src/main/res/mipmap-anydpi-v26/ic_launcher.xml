<?xml version="1.0" encoding="utf-8"?>
<!--
  Icona adattiva: sfondo e primo piano separati, cosi' il launcher puo' ritagliarla nella
  forma che preferisce e animarla.

  Serve solo la versione v26 perche' l'app parte da Android 8: sotto quella soglia non
  arriva, e le vecchie icone quadrate a piu' risoluzioni sarebbero peso morto.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
