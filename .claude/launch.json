{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mockups",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "const http=require('http'),fs=require('fs'),p=require('path');const root=p.join(process.cwd(),'docs','mockups');const types={'.html':'text/html; charset=utf-8','.css':'text/css','.js':'text/javascript','.svg':'image/svg+xml','.png':'image/png'};http.createServer((req,res)=>{let f=decodeURIComponent(req.url.split('?')[0]);if(f==='/')f='/index.html';const full=p.join(root,f);if(!full.startsWith(root)){res.writeHead(403);return res.end();}fs.readFile(full,(e,d)=>{if(e){res.writeHead(404,{'content-type':'text/html; charset=utf-8'});return res.end('<h1>404</h1><p>'+f+'</p>');}res.writeHead(200,{'content-type':types[p.extname(full)]||'application/octet-stream'});res.end(d);});}).listen(4173,()=>console.log('mockups su http://localhost:4173'));"
      ],
      "port": 4173
    }
  ]
}
